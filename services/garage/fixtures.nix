# `services.garage.runtime` fixtures, shared by the VM test in ./checks.nix and
# by the `garage-rendered-fixtures` package.
#
# why the indirection: `garage-rendered-fixtures` renders these through the
# real option system and renderer, so the `.tf.json` snapshot that guards
# refactors of the resource surface is produced from exactly the configuration
# the VM test proves converges against a live Garage.
{
  # Everything the VM test declares at boot. Spans all three resources, both
  # ways a key comes to be (generated by Garage, or imported with a given id
  # and secret), and per-secret `<attr>File` indirection.
  main = {
    bucket.photos = {
      max_objects = 1000;
      max_size = 1073741824;
      website_access = {
        enabled = true;
        index_document = "index.html";
        error_document = "error.html";
      };
    };
    bucket.backups = { };

    # Garage generates the id and the secret.
    key.app = { };

    # With both an id and a secret, the provider imports the key rather than
    # generating it, so clients can keep credentials they already hold. The
    # secret comes from a host file via LoadCredential, so the literal never
    # lands in the generated .tf.json.
    key.imported = {
      access_key_id = "GK0123456789abcdef01234567";
      secret_access_keyFile = "/etc/garage-imported-secret";
    };

    # bucket_id and access_key_id take the keys of the managed bucket and key ->
    # emitted as `${garage_bucket.<k>.id}` and `${garage_key.<k>.id}`.
    bucket_key.app_photos = {
      bucket_id = "photos";
      access_key_id = "app";
      read = true;
      write = true;
      owner = true;
    };
    bucket_key.imported_photos = {
      bucket_id = "photos";
      access_key_id = "imported";
      read = true;
      write = false;
      owner = false;
    };
    bucket_key.imported_backups = {
      bucket_id = "backups";
      access_key_id = "imported";
      read = false;
      write = true;
      owner = false;
    };
  };
}
