          "is_hardcoded": {
            "computed": true,
            "description": "Is this attribute hardcoded (i.e. managed by LLDAP)?",
            "description_kind": "plain",
            "type": "bool"
          },
          "is_list": {
            "description": "Does this represent a list?",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "is_readonly": {
            "computed": true,
            "description": "Is this attribute readonly (i.e. managed by LLDAP)?",
            "description_kind": "plain",
            "type": "bool"
          },
          "is_visible": {
            "description": "Is this attribute visible in LDAP?",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "name": {
            "description": "The unique attribute name",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          }
        },
        "description": "Defines a new custom attribute schema for users",
        "description_kind": "plain"
      },
      "version": 0
    },
    "lldap_user_attribute_assignment": {
      "block": {
        "attributes": {
          "attribute_id": {
            "description": "The attribute name",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "id": {
            "computed": true,
            "description": "The assignment 'ID', constructed as user_id:attribute_name",
            "description_kind": "plain",
            "type": "string"
          },
          "user_id": {
            "description": "The unique user ID",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "value": {
            "description": "The value(s) for this attribute",
            "description_kind": "plain",
            "required": true,
            "type": [
              "set",
              "string"
            ]
          }
        },
        "description": "Manage a custom attribute assignment for an user",
        "description_kind": "plain"
      },
      "version": 0
