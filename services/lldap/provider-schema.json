              "set",
              "string"
            ]
          },
          "id": {
            "computed": true,
            "description": "ID representing this specific user memberships",
            "description_kind": "plain",
            "type": "string"
          },
          "user_id": {
            "description": "The unique user id",
            "description_kind": "plain",
            "required": true,
