{
  "format_version": "1.0",
  "resource_schemas": {
    "postgresql_database": {
      "block": {
        "attributes": {
          "allow_connections": {
            "description": "If false then no one can connect to this database",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "alter_object_ownership": {
            "description": "If true, the owner of already existing objects will change if the owner changes",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "connection_limit": {
            "description": "How many concurrent connections can be made to this database",
            "description_kind": "plain",
            "optional": true,
            "type": "number"
          },
          "encoding": {
            "computed": true,
            "description": "Character set encoding to use in the new database",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "is_template": {
            "computed": true,
            "description": "If true, then this database can be cloned by any user with CREATEDB privileges",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "lc_collate": {
            "computed": true,
            "description": "Collation order (LC_COLLATE) to use in the new database",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "lc_ctype": {
            "computed": true,
            "description": "Character classification (LC_CTYPE) to use in the new database",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "name": {
            "description": "The PostgreSQL database name to connect to",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "owner": {
            "computed": true,
            "description": "The ROLE which owns the database",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "tablespace_name": {
            "computed": true,
            "description": "The name of the tablespace that will be associated with the new database",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "template": {
            "computed": true,
            "description": "The name of the template from which to create the new database",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_default_privileges": {
      "block": {
        "attributes": {
          "database": {
            "description": "The database to grant default privileges for this role",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "object_type": {
            "description": "The PostgreSQL object type to set the default privileges on (one of: table, sequence, function, routine, type, schema)",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "owner": {
            "description": "Target role for which to alter default privileges.",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "privileges": {
            "description": "The list of privileges to apply as default privileges",
            "description_kind": "plain",
            "required": true,
            "type": [
              "set",
              "string"
            ]
          },
          "role": {
            "description": "The name of the role to which grant default privileges on",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "schema": {
            "description": "The database schema to set default privileges for this role",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "with_grant_option": {
            "description": "Permit the grant recipient to grant it to others",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_extension": {
      "block": {
        "attributes": {
          "create_cascade": {
            "description": "When true, will also create any extensions that this extension depends on that are not already installed",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "database": {
            "computed": true,
            "description": "Sets the database to add the extension to",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "drop_cascade": {
            "description": "When true, will also drop all the objects that depend on the extension, and in turn all objects that depend on those objects",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "name": {
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "schema": {
            "computed": true,
            "description": "Sets the schema of an extension",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "version": {
            "computed": true,
            "description": "Sets the version number of the extension",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_function": {
      "block": {
        "attributes": {
          "body": {
            "description": "Body of the function.",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "database": {
            "computed": true,
            "description": "The database where the function is located. If not specified, the provider default database is used.",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "drop_cascade": {
            "description": "Automatically drop objects that depend on the function (such as operators or triggers), and in turn all objects that depend on those objects.",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "language": {
            "description": "Language of the function. One of: internal, sql, c, plpgsql",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "name": {
            "description": "Name of the function.",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "parallel": {
            "description": "If the function can be executed in parallel for a single query execution. One of: UNSAFE, RESTRICTED, SAFE",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "returns": {
            "computed": true,
            "description": "Function return type. If not specified, it will be calculated based on the output arguments",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "schema": {
            "computed": true,
            "description": "Schema where the function is located. If not specified, the provider default schema is used.",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "security_definer": {
            "description": "If the function should execute with the permissions of the function owner instead of the permissions of the caller.",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "strict": {
            "description": "If the function should always return NULL if any of it's inputs is NULL.",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "volatility": {
            "description": "Volatility of the function. One of: VOLATILE, STABLE, IMMUTABLE.",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          }
        },
        "block_types": {
          "arg": {
            "block": {
              "attributes": {
                "default": {
                  "description": "An expression to be used as default value if the parameter is not specified.",
                  "description_kind": "plain",
                  "optional": true,
                  "type": "string"
                },
                "mode": {
                  "description": "The argument mode. One of: IN, OUT, INOUT, or VARIADIC",
                  "description_kind": "plain",
                  "optional": true,
                  "type": "string"
                },
                "name": {
                  "description": "The argument name. The name may be required for some languages or depending on the argument mode.",
                  "description_kind": "plain",
                  "optional": true,
                  "type": "string"
                },
                "type": {
                  "description": "The argument type.",
                  "description_kind": "plain",
                  "required": true,
                  "type": "string"
                }
              },
              "description": "Function argument definitions.",
              "description_kind": "plain"
            },
            "nesting_mode": "list"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_grant": {
      "block": {
        "attributes": {
          "columns": {
            "description": "The specific columns to grant privileges on for this role",
            "description_kind": "plain",
            "optional": true,
            "type": [
              "set",
              "string"
            ]
          },
          "database": {
            "description": "The database to grant privileges on for this role",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "object_type": {
            "description": "The PostgreSQL object type to grant the privileges on (one of: database, function, procedure, routine, schema, sequence, table, foreign_data_wrapper, foreign_server, column)",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "objects": {
            "description": "The specific objects to grant privileges on for this role (empty means all objects of the requested type)",
            "description_kind": "plain",
            "optional": true,
            "type": [
              "set",
              "string"
            ]
          },
          "privileges": {
            "description": "The list of privileges to grant",
            "description_kind": "plain",
            "required": true,
            "type": [
              "set",
              "string"
            ]
          },
          "role": {
            "description": "The name of the role to grant privileges on",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "schema": {
            "description": "The database schema to grant privileges on for this role",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "with_grant_option": {
            "description": "Permit the grant recipient to grant it to others",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_grant_role": {
      "block": {
        "attributes": {
          "grant_role": {
            "description": "The name of the role that is granted to role",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "role": {
            "description": "The name of the role to grant grant_role",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "with_admin_option": {
            "description": "Permit the grant recipient to grant it to others",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_physical_replication_slot": {
      "block": {
        "attributes": {
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "name": {
            "description_kind": "plain",
            "required": true,
            "type": "string"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_publication": {
      "block": {
        "attributes": {
          "all_tables": {
            "computed": true,
            "description": "Sets the tables list to publish to ALL tables",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "database": {
            "computed": true,
            "description": "Sets the database to add the publication for",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "drop_cascade": {
            "description": "When true, will also drop all the objects that depend on the publication, and in turn all objects that depend on those objects",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "name": {
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "owner": {
            "computed": true,
            "description": "Sets the owner of the publication",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "publish_param": {
            "computed": true,
            "description": "Sets which DML operations will be published",
            "description_kind": "plain",
            "optional": true,
            "type": [
              "list",
              "string"
            ]
          },
          "publish_via_partition_root_param": {
            "description": "Sets whether changes in a partitioned table using the identity and schema of the partitioned table",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "tables": {
            "computed": true,
            "description": "Sets the tables list to publish",
            "description_kind": "plain",
            "optional": true,
            "type": [
              "set",
              "string"
            ]
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_replication_slot": {
      "block": {
        "attributes": {
          "database": {
            "computed": true,
            "description": "Sets the database to add the replication slot to",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "name": {
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "plugin": {
            "description": "Sets the output plugin to use",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_role": {
      "block": {
        "attributes": {
          "assume_role": {
            "description": "Role to switch to at login",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "bypass_row_level_security": {
            "description": "Determine whether a role bypasses every row-level security (RLS) policy",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "connection_limit": {
            "description": "How many concurrent connections can be made with this role",
            "description_kind": "plain",
            "optional": true,
            "type": "number"
          },
          "create_database": {
            "description": "Define a role's ability to create databases",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "create_role": {
            "description": "Determine whether this role will be permitted to create new roles",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "encrypted": {
            "deprecated": true,
            "deprecation_message": "Rename PostgreSQL role resource attribute \"encrypted\" to \"encrypted_password\"",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "encrypted_password": {
            "description": "Control whether the password is stored encrypted in the system catalogs",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "idle_in_transaction_session_timeout": {
            "description": "Terminate any session with an open transaction that has been idle for longer than the specified duration in milliseconds",
            "description_kind": "plain",
            "optional": true,
            "type": "number"
          },
          "inherit": {
            "description": "Determine whether a role \"inherits\" the privileges of roles it is a member of",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "login": {
            "description": "Determine whether a role is allowed to log in",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "name": {
            "description": "The name of the role",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "password": {
            "description": "Sets the role's password",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true,
            "type": "string"
          },
          "password_wo": {
            "description": "Sets the role's password without storing it in the state file.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true,
            "type": "string",
            "write_only": true
          },
          "password_wo_version": {
            "description": "Prevents applies from updating the role password on every apply unless the value changes.",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "replication": {
            "description": "Determine whether a role is allowed to initiate streaming replication or put the system in and out of backup mode",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "roles": {
            "description": "Role(s) to grant to this new role",
            "description_kind": "plain",
            "optional": true,
            "type": [
              "set",
              "string"
            ]
          },
          "search_path": {
            "description": "Sets the role's search path",
            "description_kind": "plain",
            "optional": true,
            "type": [
              "list",
              "string"
            ]
          },
          "skip_drop_role": {
            "description": "Skip actually running the DROP ROLE command when removing a ROLE from PostgreSQL",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "skip_reassign_owned": {
            "description": "Skip actually running the REASSIGN OWNED command when removing a role from PostgreSQL",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "statement_timeout": {
            "description": "Abort any statement that takes more than the specified number of milliseconds",
            "description_kind": "plain",
            "optional": true,
            "type": "number"
          },
          "superuser": {
            "description": "Determine whether the new role is a \"superuser\"",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "valid_until": {
            "description": "Sets a date and time after which the role's password is no longer valid",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_schema": {
      "block": {
        "attributes": {
          "database": {
            "computed": true,
            "description": "The database name to alter schema",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "drop_cascade": {
            "description": "When true, will also drop all the objects that are contained in the schema",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "if_not_exists": {
            "description": "When true, use the existing schema if it exists",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "name": {
            "description": "The name of the schema",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "owner": {
            "computed": true,
            "description": "The ROLE name who owns the schema",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          }
        },
        "block_types": {
          "policy": {
            "block": {
              "attributes": {
                "create": {
                  "description": "If true, allow the specified ROLEs to CREATE new objects within the schema(s)",
                  "description_kind": "plain",
                  "optional": true,
                  "type": "bool"
                },
                "create_with_grant": {
                  "description": "If true, allow the specified ROLEs to CREATE new objects within the schema(s) and GRANT the same CREATE privilege to different ROLEs",
                  "description_kind": "plain",
                  "optional": true,
                  "type": "bool"
                },
                "role": {
                  "description": "ROLE who will receive this policy (default: PUBLIC)",
                  "description_kind": "plain",
                  "optional": true,
                  "type": "string"
                },
                "usage": {
                  "description": "If true, allow the specified ROLEs to use objects within the schema(s)",
                  "description_kind": "plain",
                  "optional": true,
                  "type": "bool"
                },
                "usage_with_grant": {
                  "description": "If true, allow the specified ROLEs to use objects within the schema(s) and GRANT the same USAGE privilege to different ROLEs",
                  "description_kind": "plain",
                  "optional": true,
                  "type": "bool"
                }
              },
              "deprecated": true,
              "deprecation_message": "Use postgresql_grant resource instead (with object_type=\"schema\")",
              "description_kind": "plain"
            },
            "nesting_mode": "set"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_security_label": {
      "block": {
        "attributes": {
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "label": {
            "description": "The label to be applied",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "label_provider": {
            "description": "The provider to apply the security label for",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "object_name": {
            "description": "The name of the existing object to apply the security label to",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "object_type": {
            "description": "The type of the existing object to apply the security label to",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          }
        },
        "description_kind": "plain"
      },
      "version": 0
    },
    "postgresql_server": {
      "block": {
        "attributes": {
          "drop_cascade": {
            "description": "Automatically drop objects that depend on the server (such as user mappings), and in turn all objects that depend on those objects. Drop RESTRICT is the default",
            "description_kind": "plain",
            "optional": true,
            "type": "bool"
          },
          "fdw_name": {
            "description": "The name of the foreign-data wrapper that manages the server",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "id": {
            "computed": true,
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
          "options": {
            "description": "This clause specifies the options for the server. The options typically define the connection details of the server, but the actual names and values are dependent on the server's foreign-data wrapper",
            "description_kind": "plain",
            "optional": true,
            "type": [
              "map",
              "string"
            ]
          },
          "server_name": {
            "description": "The name of the foreign server to be created",
            "description_kind": "plain",
            "required": true,
            "type": "string"
          },
          "server_owner": {
            "computed": true,
            "description": "The user name of the new owner of the foreign server",
            "description_kind": "plain",
            "optional": true,
            "type": "string"
          },
